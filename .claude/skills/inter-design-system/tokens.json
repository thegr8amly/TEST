{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "navy": { "$value": "#132544" },
    "navy-900": { "$value": "#0f1d36" },
    "navy-950": { "$value": "#0a1426" },
    "navy-700": { "$value": "#1d3561" },
    "royal": { "$value": "#034a89" },
    "gold": { "$value": "#faac26" },
    "gold-300": { "$value": "#fcc964" },
    "gold-100": { "$value": "#fff1d6" },
    "mist": { "$value": "#f4f6fb" },
    "line": { "$value": "#e3e8f2" },
    "text": { "primary": { "$value": "#0f172a" }, "body": { "$value": "#334155" }, "muted": { "$value": "#475569" } },
    "status": {
      "success-fg": { "$value": "#2c6e22" },
      "warning-fg": { "$value": "#5c3b00" },
      "critical-fg": { "$value": "#9b1c26" }
    },
    "sdg-texture": { "$value": ["#d13b45", "#f5a03a", "#4aa352", "#b31b2b", "#51b3d6", "#f8b800", "#0a79b8", "#31d0a1"], "$description": "Brand texture only (sdg-bar). Not for UI state." }
  },
  "font": {
    "display": { "$value": "Montserrat", "weights": [700, 800] },
    "text": { "$value": "Inter", "weights": "variable" }
  },
  "radius": { "control": { "$value": "8px" }, "button": { "$value": "12px" }, "card": { "$value": "16px" }, "pill": { "$value": "9999px" } },
  "space": { "unit": { "$value": "4px" }, "section-desktop": { "$value": "80px" }, "section-mobile": { "$value": "64px" }, "gutter-mobile": { "$value": "16px" } },
  "motion": { "state": { "$value": "150-200ms" }, "reveal": { "$value": "600ms, translateY 12px, once" }, "reducedMotion": { "$value": "disable all" } }
}
