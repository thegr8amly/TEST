# ── AI scoring (Writing & Speaking) ─────────────────────────────
# Without this key the test still works: Writing/Speaking get a provisional
# automatic score (heuristic) flagged for teacher review.
ANTHROPIC_API_KEY=
# Optional override (default: claude-opus-5-5)
SCORING_MODEL=

# ── Persistence (Vercel Blob, private store) ────────────────────
# Created automatically when a Blob store is connected to the Vercel project.
BLOB_READ_WRITE_TOKEN=

# ── Admin dashboard (/admin) ────────────────────────────────────
ADMIN_KEY=

# ── Integration: POST every finished result (Baseline Record JSON) ──
# e.g. a Google Apps Script web app that appends to ELR_INTER, or the
# Campus Virtual API. Optional shared secret sent as X-Inter-Signature (HMAC-SHA256).
RESULTS_WEBHOOK_URL=
RESULTS_WEBHOOK_SECRET=
